{{ 'browse-by-style.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #BrowseByStyle-{{ section.id }} {
    --browse-padding-top: {{ section.settings.padding_top }}px;
    --browse-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="BrowseByStyle-{{ section.id }}"
  class="browse-by-style"
  aria-labelledby="BrowseByStyleHeading-{{ section.id }}"
>
  <div class="page-container">
    <div class="browse-by-style__wrapper">
      {%- if section.settings.heading != blank -%}
        <h2 id="BrowseByStyleHeading-{{ section.id }}" class="browse-by-style__heading">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <div class="browse-by-style__grid">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign card_title = block.settings.title -%}
            {%- assign card_collection = block.settings.collection -%}
            {%- if card_title == blank and card_collection != blank -%}
              {%- assign card_title = card_collection.title -%}
            {%- endif -%}
            {%- if card_title == blank -%}
              {%- assign card_title = 'Style ' | append: forloop.index -%}
            {%- endif -%}

            {%- assign card_url = block.settings.link -%}
            {%- if card_url == blank and card_collection != blank -%}
              {%- assign card_url = card_collection.url -%}
            {%- endif -%}
            {%- if card_url == blank -%}
              {%- assign card_url = routes.all_products_collection_url -%}
            {%- endif -%}

            {%- assign card_image = block.settings.image -%}
            {%- if card_image == blank and card_collection.image != blank -%}
              {%- assign card_image = card_collection.image -%}
            {%- endif -%}

            {%- assign span_class = 'browse-by-style__card--span-6' -%}
            {%- if block.settings.column_span == 'span_10' -%}
              {%- assign span_class = 'browse-by-style__card--span-10' -%}
            {%- endif -%}

            <a
              href="{{ card_url }}"
              class="browse-by-style__card {{ span_class }}"
              {{ block.shopify_attributes }}
              aria-label="{{ card_title | escape }}"
            >
              <span class="browse-by-style__card-title">{{ card_title | escape }}</span>
              <div class="browse-by-style__card-media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'browse-by-style__card-image',
                      widths: '300, 450, 600, 800, 1000, 1200',
                      loading: 'lazy',
                      alt: card_title
                  }}
                {%- else -%}
                  {%- assign placeholder_idx = forloop.index | modulo: 6 | plus: 1 -%}
                  {%- assign placeholder_name = 'collection-' | append: placeholder_idx -%}
                  {{ placeholder_name | placeholder_svg_tag: 'browse-by-style__card-placeholder' }}
                {%- endif -%}
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Default 4 cards matching Figma mockup {%- endcomment -%}
          <a href="{{ routes.all_products_collection_url }}" class="browse-by-style__card browse-by-style__card--span-6" aria-label="Casual">
            <span class="browse-by-style__card-title">Casual</span>
            <div class="browse-by-style__card-media">
              {{ 'collection-1' | placeholder_svg_tag: 'browse-by-style__card-placeholder' }}
            </div>
          </a>
          <a href="{{ routes.all_products_collection_url }}" class="browse-by-style__card browse-by-style__card--span-10" aria-label="Formal">
            <span class="browse-by-style__card-title">Formal</span>
            <div class="browse-by-style__card-media">
              {{ 'collection-2' | placeholder_svg_tag: 'browse-by-style__card-placeholder' }}
            </div>
          </a>
          <a href="{{ routes.all_products_collection_url }}" class="browse-by-style__card browse-by-style__card--span-10" aria-label="Party">
            <span class="browse-by-style__card-title">Party</span>
            <div class="browse-by-style__card-media">
              {{ 'collection-3' | placeholder_svg_tag: 'browse-by-style__card-placeholder' }}
            </div>
          </a>
          <a href="{{ routes.all_products_collection_url }}" class="browse-by-style__card browse-by-style__card--span-6" aria-label="Gym">
            <span class="browse-by-style__card-title">Gym</span>
            <div class="browse-by-style__card-media">
              {{ 'collection-4' | placeholder_svg_tag: 'browse-by-style__card-placeholder' }}
            </div>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Browse by dress style",
  "tag": "section",
  "class": "section-browse-by-style",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BROWSE BY DRESS STYLE"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "style_card",
      "name": "Style card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave blank to use collection title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave blank to use collection featured image"
        },
        {
          "type": "select",
          "id": "column_span",
          "label": "Column width (desktop 16-part grid)",
          "default": "span_6",
          "options": [
            {
              "value": "span_6",
              "label": "Small (Span 6 of 16)"
            },
            {
              "value": "span_10",
              "label": "Large (Span 10 of 16)"
            }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Optional override if collection is not selected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Browse by dress style",
      "blocks": [
        {
          "type": "style_card",
          "settings": {
            "title": "Casual",
            "column_span": "span_6"
          }
        },
        {
          "type": "style_card",
          "settings": {
            "title": "Formal",
            "column_span": "span_10"
          }
        },
        {
          "type": "style_card",
          "settings": {
            "title": "Party",
            "column_span": "span_10"
          }
        },
        {
          "type": "style_card",
          "settings": {
            "title": "Gym",
            "column_span": "span_6"
          }
        }
      ]
    }
  ]
}
{% endschema %}

