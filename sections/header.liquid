{{ 'header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>

<div
  class="site-header-wrapper{% if section.settings.enable_sticky_header %} site-header--sticky{% endif %}"
  data-section-id="{{ section.id }}"
>
  <header class="site-header">
    <div class="page-container site-header__container">
      
      <!-- Mobile Menu Toggle Button (Visible <= 1024px) -->
      <button
        type="button"
        class="site-header__menu-toggle"
        aria-expanded="false"
        aria-controls="MobileNavDrawer"
        aria-label="{{ 'sections.header.menu' | t | default: 'Open navigation menu' }}"
        data-mobile-menu-toggle
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

      <!-- Logo -->
      <div class="site-header__logo-wrapper">
        <a href="{{ routes.root_url }}" class="site-header__logo-link">
          {%- if settings.logo != blank -%}
            {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
            {{ settings.logo | image_url: width: 320 | image_tag:
              class: 'site-header__logo-image',
              widths: '120, 160, 200, 240, 320',
              height: null,
              alt: logo_alt
            }}
          {%- else -%}
            <span class="site-header__logo-text">{{ shop.name | default: 'SHOP.CO' }}</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Desktop Navigation (Visible > 1024px) -->
      <nav class="site-header__nav" aria-label="{{ 'sections.header.menu' | t | default: 'Main navigation' }}">
        <ul class="site-header__nav-list">
          {%- for link in linklists[section.settings.menu].links -%}
            <li class="site-header__nav-item{% if link.links != blank %} has-dropdown{% endif %}">
              {%- if link.links != blank -%}
                <details class="site-header__dropdown-details">
                  <summary class="site-header__nav-link" aria-expanded="false">
                    <span>{{ link.title | escape }}</span>
                    <svg class="site-header__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" focusable="false">
                      <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>
                  <ul class="site-header__dropdown-menu">
                    {%- for childlink in link.links -%}
                      <li>
                        <a href="{{ childlink.url }}" class="site-header__dropdown-link{% if childlink.current %} is-active{% endif %}">
                          {{ childlink.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="site-header__nav-link{% if link.current %} is-active{% endif %}">
                  {{ link.title | escape }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <!-- Search Bar (Desktop & Expandable on Mobile) -->
      <div class="site-header__search" id="SiteHeaderSearch" data-header-search>
        <form action="{{ routes.search_url }}" method="get" role="search" class="site-header__search-form">
          <div class="site-header__search-input-wrapper">
            <span class="site-header__search-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </span>
            <input
              type="search"
              name="q"
              id="SearchInput-{{ section.id }}"
              value="{{ search.terms | escape }}"
              class="site-header__search-input"
              placeholder="{{ section.settings.search_placeholder | default: 'Search for products...' }}"
              autocomplete="off"
              aria-label="{{ 'general.search.search' | t | default: 'Search' }}"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <!-- Close button when mobile search is expanded -->
            <button type="button" class="site-header__search-close" aria-label="Close search" data-mobile-search-close>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </form>
      </div>

      <!-- Right Action Icons (Mobile Search, Cart, Account) -->
      <div class="site-header__actions">
        <!-- Mobile Search Trigger -->
        <button
          type="button"
          class="site-header__action-btn site-header__search-toggle"
          aria-expanded="false"
          aria-controls="SiteHeaderSearch"
          aria-label="{{ 'general.search.search' | t | default: 'Open search' }}"
          data-mobile-search-toggle
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>

        <!-- Cart Link -->
        <a href="{{ routes.cart_url }}" class="site-header__action-btn site-header__cart-link" id="cart-icon-bubble" aria-label="{{ 'templates.cart.cart' | t | default: 'Cart' }}">
          {% render 'icon-cart' %}
          <span class="site-header__cart-count{% if cart.item_count == 0 %} is-hidden{% endif %}" data-cart-count aria-hidden="true">
            {{ cart.item_count }}
          </span>
          <span class="visually-hidden">
            {{ 'sections.header.cart_count' | t: count: cart.item_count | default: cart.item_count }}
          </span>
        </a>

        <!-- Account Link -->
        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="site-header__action-btn site-header__account-link"
            aria-label="{{ 'customer.account_fallback' | t | default: 'Account' }}"
          >
            {% render 'icon-account' %}
          </a>
        {%- else -%}
          <a href="{{ routes.account_login_url }}" class="site-header__action-btn site-header__account-link" aria-label="Account">
            {% render 'icon-account' %}
          </a>
        {%- endif -%}
      </div>

    </div>
  </header>

  <!-- Mobile Navigation Drawer -->
  <div class="site-header__drawer-backdrop" data-drawer-backdrop tabindex="-1" aria-hidden="true"></div>
  <div class="site-header__drawer" id="MobileNavDrawer" aria-label="Mobile Navigation" role="dialog" aria-modal="true" data-mobile-drawer>
    <div class="site-header__drawer-header">
      <span class="site-header__logo-text">{{ shop.name | default: 'SHOP.CO' }}</span>
      <button type="button" class="site-header__drawer-close" aria-label="Close menu" data-drawer-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <nav class="site-header__drawer-nav">
      <ul class="site-header__drawer-list">
        {%- for link in linklists[section.settings.menu].links -%}
          <li class="site-header__drawer-item">
            {%- if link.links != blank -%}
              <details class="site-header__drawer-details">
                <summary class="site-header__drawer-link">
                  <span>{{ link.title | escape }}</span>
                  <svg class="site-header__chevron" width="14" height="14" viewBox="0 0 12 12" fill="none">
                    <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <ul class="site-header__drawer-sublist">
                  {%- for childlink in link.links -%}
                    <li>
                      <a href="{{ childlink.url }}" class="site-header__drawer-sublink{% if childlink.current %} is-active{% endif %}">
                        {{ childlink.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="site-header__drawer-link{% if link.current %} is-active{% endif %}">
                {{ link.title | escape }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "default": true,
      "label": "Enable sticky header"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "default": "Search for products...",
      "label": "Search placeholder"
    }
  ]
}
{% endschema %}
