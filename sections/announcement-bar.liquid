{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
<script src="{{ 'announcement-bar.js' | asset_url }}" defer="defer"></script>

<aside
  class="announcement-bar-section"
  data-section-id="{{ section.id }}"
  style="
    --announcement-bg: {{ section.settings.background_color }};
    --announcement-text: {{ section.settings.text_color }};
  "
  aria-label="{{ 'sections.header.announcement' | t | default: 'Announcement' }}"
>
  <div class="page-container announcement-bar__container">
    <div class="announcement-bar__content">
      <p class="announcement-bar__text">
        {{ section.settings.text }}
        {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
          <a
            href="{{ section.settings.link_url }}"
            class="announcement-bar__link"
          >
            {{- section.settings.link_text -}}
          </a>
        {%- endif -%}
      </p>
    </div>

    {%- if section.settings.show_close_button -%}
      <button
        type="button"
        class="announcement-bar__close"
        aria-label="{{ 'accessibility.close' | t | default: 'Close announcement' }}"
        data-announcement-close
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 14 14"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M1 1L13 13M1 13L13 1"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section-announcement-bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Sign up and get 20% off to your first order."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Sign Up Now"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "Show close button",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}

