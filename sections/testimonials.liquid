{{ 'testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testimonials.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  #Testimonials-{{ section.id }} {
    --testimonials-padding-top: {{ section.settings.padding_top }}px;
    --testimonials-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="Testimonials-{{ section.id }}"
  class="testimonials"
  aria-labelledby="TestimonialsHeading-{{ section.id }}"
>
  <div class="page-container testimonials__container">
    <div class="testimonials__header">
      {%- if section.settings.heading != blank -%}
        <h2 id="TestimonialsHeading-{{ section.id }}" class="testimonials__title">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <div class="testimonials__nav" aria-label="Testimonials navigation">
        <button
          type="button"
          class="testimonials__arrow testimonials__arrow--prev"
          aria-label="Previous testimonial"
          data-direction="prev"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="testimonials__arrow testimonials__arrow--next"
          aria-label="Next testimonial"
          data-direction="next"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <testimonials-slider class="testimonials__slider" role="region" aria-label="Customer Reviews">
      <div class="testimonials__track" data-track>
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign rating_val = block.settings.rating | default: 5 -%}
            <article class="testimonials__card" {{ block.shopify_attributes }}>
              <div class="testimonials__stars" aria-label="{{ rating_val }} out of 5 stars">
                {%- for i in (1..5) -%}
                  {%- if i <= rating_val -%}
                    <svg class="testimonials__star" width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M11.5 18.25L4.38521 21.9934L5.74415 14.0722L0 8.46328L7.9426 7.30664L11.5 0.106641L15.0574 7.30664L23 8.46328L17.2559 14.0722L18.6148 21.9934L11.5 18.25Z" fill="#FFC633"/>
                    </svg>
                  {%- else -%}
                    <svg class="testimonials__star" width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M11.5 18.25L4.38521 21.9934L5.74415 14.0722L0 8.46328L7.9426 7.30664L11.5 0.106641L15.0574 7.30664L23 8.46328L17.2559 14.0722L18.6148 21.9934L11.5 18.25Z" fill="#E5E5E5"/>
                    </svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <div class="testimonials__author-row">
                <span class="testimonials__author">{{ block.settings.author | escape }}</span>
                {%- if block.settings.verified -%}
                  <span class="testimonials__badge" title="Verified Customer" aria-label="Verified Customer">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <circle cx="10" cy="10" r="10" fill="#01AB31"/>
                      <path d="M6 10.5L8.5 13L14 7.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                {%- endif -%}
              </div>

              <div class="testimonials__quote">
                <p>&ldquo;{{ block.settings.review | escape }}&rdquo;</p>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Default fallback matching Figma {%- endcomment -%}
          <article class="testimonials__card">
            <div class="testimonials__stars" aria-label="5 out of 5 stars">
              {%- for i in (1..5) -%}
                <svg class="testimonials__star" width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M11.5 18.25L4.38521 21.9934L5.74415 14.0722L0 8.46328L7.9426 7.30664L11.5 0.106641L15.0574 7.30664L23 8.46328L17.2559 14.0722L18.6148 21.9934L11.5 18.25Z" fill="#FFC633"/>
                </svg>
              {%- endfor -%}
            </div>
            <div class="testimonials__author-row">
              <span class="testimonials__author">Sarah M.</span>
              <span class="testimonials__badge" title="Verified Customer" aria-label="Verified Customer">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#01AB31"/>
                  <path d="M6 10.5L8.5 13L14 7.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <div class="testimonials__quote">
              <p>&ldquo;I'm blown away by the quality and style of the clothes I received from Shop.co. From casual wear to elegant dresses, every piece I've bought has exceeded my expectations.&rdquo;</p>
            </div>
          </article>

          <article class="testimonials__card">
            <div class="testimonials__stars" aria-label="5 out of 5 stars">
              {%- for i in (1..5) -%}
                <svg class="testimonials__star" width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M11.5 18.25L4.38521 21.9934L5.74415 14.0722L0 8.46328L7.9426 7.30664L11.5 0.106641L15.0574 7.30664L23 8.46328L17.2559 14.0722L18.6148 21.9934L11.5 18.25Z" fill="#FFC633"/>
                </svg>
              {%- endfor -%}
            </div>
            <div class="testimonials__author-row">
              <span class="testimonials__author">Alex K.</span>
              <span class="testimonials__badge" title="Verified Customer" aria-label="Verified Customer">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#01AB31"/>
                  <path d="M6 10.5L8.5 13L14 7.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <div class="testimonials__quote">
              <p>&ldquo;Finding clothes that align with my personal style used to be a challenge until I discovered Shop.co. The range of options they offer is truly remarkable, catering to a variety of tastes and occasions.&rdquo;</p>
            </div>
          </article>

          <article class="testimonials__card">
            <div class="testimonials__stars" aria-label="5 out of 5 stars">
              {%- for i in (1..5) -%}
                <svg class="testimonials__star" width="23" height="23" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M11.5 18.25L4.38521 21.9934L5.74415 14.0722L0 8.46328L7.9426 7.30664L11.5 0.106641L15.0574 7.30664L23 8.46328L17.2559 14.0722L18.6148 21.9934L11.5 18.25Z" fill="#FFC633"/>
                </svg>
              {%- endfor -%}
            </div>
            <div class="testimonials__author-row">
              <span class="testimonials__author">James L.</span>
              <span class="testimonials__badge" title="Verified Customer" aria-label="Verified Customer">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#01AB31"/>
                  <path d="M6 10.5L8.5 13L14 7.5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
            <div class="testimonials__quote">
              <p>&ldquo;As someone who's always on the lookout for unique fashion pieces, I'm thrilled to have stumbled upon Shop.co. The selection of clothes is not only diverse but also on-point with the latest trends.&rdquo;</p>
            </div>
          </article>
        {%- endif -%}
      </div>
    </testimonials-slider>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUR HAPPY CUSTOMERS"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Sarah M."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified buyer badge",
          "default": true
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review text",
          "default": "I'm blown away by the quality and style of the clothes I received from Shop.co. From casual wear to elegant dresses, every piece I've bought has exceeded my expectations."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "author": "Sarah M.",
            "rating": 5,
            "verified": true,
            "review": "I'm blown away by the quality and style of the clothes I received from Shop.co. From casual wear to elegant dresses, every piece I've bought has exceeded my expectations."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "Alex K.",
            "rating": 5,
            "verified": true,
            "review": "Finding clothes that align with my personal style used to be a challenge until I discovered Shop.co. The range of options they offer is truly remarkable, catering to a variety of tastes and occasions."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "James L.",
            "rating": 5,
            "verified": true,
            "review": "As someone who's always on the lookout for unique fashion pieces, I'm thrilled to have stumbled upon Shop.co. The selection of clothes is not only diverse but also on-point with the latest trends."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "Moo M.",
            "rating": 5,
            "verified": true,
            "review": "As someone who's always on the lookout for unique fashion pieces, I'm thrilled to have stumbled upon Shop.co. The selection of clothes is not only diverse but also on-point with the latest trends."
          }
        }
      ]
    }
  ]
}
{% endschema %}

