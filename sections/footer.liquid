{{ 'footer.css' | asset_url | stylesheet_tag }}

<footer class="footer-section">
  {%- if section.settings.show_newsletter -%}
    <div class="footer-newsletter__wrapper page-container">
      <div class="footer-newsletter">
        <h2 class="footer-newsletter__heading">
          {{ section.settings.newsletter_heading | default: 'STAY UPTO DATE ABOUT OUR LATEST OFFERS' | escape }}
        </h2>

        <div class="footer-newsletter__form-container">
          {% form 'customer', id: 'FooterNewsletterForm', class: 'footer-newsletter__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- if form.posted_successfully? -%}
              <p class="footer-newsletter__message" tabindex="-1" autofocus>
                Thanks for subscribing!
              </p>
            {%- else -%}
              <div class="footer-newsletter__input-group">
                <span class="footer-newsletter__input-icon" aria-hidden="true">
                  {% render 'icons', icon: 'envelope' %}
                </span>
                <input
                  type="email"
                  name="contact[email]"
                  id="NewsletterInput-{{ section.id }}"
                  class="footer-newsletter__input"
                  value="{{ form.email }}"
                  placeholder="Enter your email address"
                  aria-label="Enter your email address"
                  required
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                >
              </div>

              <button
                type="submit"
                class="footer-newsletter__submit"
                name="commit"
                aria-label="Subscribe to Newsletter"
              >
                {{ section.settings.newsletter_button_label | default: 'Subscribe to Newsletter' | escape }}
              </button>

              {%- if form.errors -%}
                <p class="footer-newsletter__message" style="color: #FF3333;">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            {%- endif -%}
          {% endform %}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="footer-main">
    <div class="page-container footer-main__container">
      <div class="footer-main__grid">
        <!-- Brand Column -->
        <div class="footer-main__brand">
          <a href="{{ routes.root_url }}" class="footer-main__logo" aria-label="{{ shop.name | escape }}">
            {{ section.settings.brand_name | default: 'SHOP.CO' | escape }}
          </a>
          <p class="footer-main__bio">
            {{ section.settings.brand_bio | default: "We have clothes that suits your style and which you're proud to wear. From women to men." | escape }}
          </p>
          <ul class="footer-main__socials" aria-label="Social media links">
            {%- assign tw_link = section.settings.social_twitter_link | default: settings.social_twitter_link | default: 'https://twitter.com' -%}
            {%- if tw_link != blank -%}
              <li>
                <a href="{{ tw_link }}" class="footer-main__social-link" target="_blank" rel="noopener" aria-label="Twitter">
                  {% render 'icons', icon: 'twitter' %}
                </a>
              </li>
            {%- endif -%}

            {%- assign fb_link = section.settings.social_facebook_link | default: settings.social_facebook_link | default: 'https://facebook.com' -%}
            {%- if fb_link != blank -%}
              <li>
                <a href="{{ fb_link }}" class="footer-main__social-link footer-main__social-link--filled" target="_blank" rel="noopener" aria-label="Facebook">
                  {% render 'icons', icon: 'facebook' %}
                </a>
              </li>
            {%- endif -%}

            {%- assign ig_link = section.settings.social_instagram_link | default: settings.social_instagram_link | default: 'https://instagram.com' -%}
            {%- if ig_link != blank -%}
              <li>
                <a href="{{ ig_link }}" class="footer-main__social-link" target="_blank" rel="noopener" aria-label="Instagram">
                  {% render 'icons', icon: 'instagram' %}
                </a>
              </li>
            {%- endif -%}

            {%- assign gh_link = section.settings.social_github_link | default: 'https://github.com' -%}
            {%- if gh_link != blank -%}
              <li>
                <a href="{{ gh_link }}" class="footer-main__social-link" target="_blank" rel="noopener" aria-label="GitHub">
                  {% render 'icons', icon: 'github' %}
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>

        <!-- Column 2: Company -->
        <div class="footer-main__col">
          <h3 class="footer-main__col-title">{{ section.settings.col_1_heading | default: 'COMPANY' | escape }}</h3>
          <ul class="footer-main__menu">
            {%- if section.settings.col_1_menu != blank and linklists[section.settings.col_1_menu].links.size > 0 -%}
              {%- for link in linklists[section.settings.col_1_menu].links -%}
                <li><a href="{{ link.url }}" class="footer-main__link">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/pages/about" class="footer-main__link">About</a></li>
              <li><a href="/pages/features" class="footer-main__link">Features</a></li>
              <li><a href="/pages/works" class="footer-main__link">Works</a></li>
              <li><a href="/pages/career" class="footer-main__link">Career</a></li>
            {%- endif -%}
          </ul>
        </div>

        <!-- Column 3: Help -->
        <div class="footer-main__col">
          <h3 class="footer-main__col-title">{{ section.settings.col_2_heading | default: 'HELP' | escape }}</h3>
          <ul class="footer-main__menu">
            {%- if section.settings.col_2_menu != blank and linklists[section.settings.col_2_menu].links.size > 0 -%}
              {%- for link in linklists[section.settings.col_2_menu].links -%}
                <li><a href="{{ link.url }}" class="footer-main__link">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/pages/support" class="footer-main__link">Customer Support</a></li>
              <li><a href="/pages/delivery" class="footer-main__link">Delivery Details</a></li>
              <li><a href="/policies/terms-of-service" class="footer-main__link">Terms & Conditions</a></li>
              <li><a href="/policies/privacy-policy" class="footer-main__link">Privacy Policy</a></li>
            {%- endif -%}
          </ul>
        </div>

        <!-- Column 4: FAQ -->
        <div class="footer-main__col">
          <h3 class="footer-main__col-title">{{ section.settings.col_3_heading | default: 'FAQ' | escape }}</h3>
          <ul class="footer-main__menu">
            {%- if section.settings.col_3_menu != blank and linklists[section.settings.col_3_menu].links.size > 0 -%}
              {%- for link in linklists[section.settings.col_3_menu].links -%}
                <li><a href="{{ link.url }}" class="footer-main__link">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/account" class="footer-main__link">Account</a></li>
              <li><a href="/pages/deliveries" class="footer-main__link">Manage Deliveries</a></li>
              <li><a href="/account/orders" class="footer-main__link">Orders</a></li>
              <li><a href="/pages/payments" class="footer-main__link">Payments</a></li>
            {%- endif -%}
          </ul>
        </div>

        <!-- Column 5: Resources -->
        <div class="footer-main__col">
          <h3 class="footer-main__col-title">{{ section.settings.col_4_heading | default: 'RESOURCES' | escape }}</h3>
          <ul class="footer-main__menu">
            {%- if section.settings.col_4_menu != blank and linklists[section.settings.col_4_menu].links.size > 0 -%}
              {%- for link in linklists[section.settings.col_4_menu].links -%}
                <li><a href="{{ link.url }}" class="footer-main__link">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            {%- else -%}
              <li><a href="/pages/ebooks" class="footer-main__link">Free eBooks</a></li>
              <li><a href="/pages/development-tutorial" class="footer-main__link">Development Tutorial</a></li>
              <li><a href="/blogs/news" class="footer-main__link">How to - Blog</a></li>
              <li><a href="https://youtube.com" target="_blank" rel="noopener" class="footer-main__link">Youtube Playlist</a></li>
            {%- endif -%}
          </ul>
        </div>
      </div>

      <hr class="footer-main__divider" aria-hidden="true">

      <div class="footer-main__bottom">
        <p class="footer-main__copyright">
          {{ section.settings.copyright_text | default: 'Shop.co © 2000-2023, All Rights Reserved' | escape }}
        </p>

        {%- if section.settings.show_payments -%}
          <ul class="footer-main__payments" aria-label="Accepted payment methods">
            <li class="footer-main__payment-badge" title="Visa">
              {% render 'icons', icon: 'visa' %}
            </li>
            <li class="footer-main__payment-badge" title="Mastercard">
              {% render 'icons', icon: 'mastercard' %}
            </li>
            <li class="footer-main__payment-badge" title="PayPal">
              {% render 'icons', icon: 'paypal' %}
            </li>
            <li class="footer-main__payment-badge" title="Apple Pay">
              {% render 'icons', icon: 'apple-pay' %}
            </li>
            <li class="footer-main__payment-badge" title="Google Pay">
              {% render 'icons', icon: 'google-pay' %}
            </li>
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer-container",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter Banner"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show floating newsletter banner",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "STAY UPTO DATE ABOUT OUR LATEST OFFERS"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Newsletter button label",
      "default": "Subscribe to Newsletter"
    },
    {
      "type": "header",
      "content": "Brand Column"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name / logo text",
      "default": "SHOP.CO"
    },
    {
      "type": "textarea",
      "id": "brand_bio",
      "label": "Brand description",
      "default": "We have clothes that suits your style and which you’re proud to wear. From women to men."
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "social_twitter_link",
      "label": "Twitter link"
    },
    {
      "type": "url",
      "id": "social_facebook_link",
      "label": "Facebook link"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Instagram link"
    },
    {
      "type": "url",
      "id": "social_github_link",
      "label": "GitHub link"
    },
    {
      "type": "header",
      "content": "Navigation Columns"
    },
    {
      "type": "text",
      "id": "col_1_heading",
      "label": "Column 1 heading",
      "default": "COMPANY"
    },
    {
      "type": "link_list",
      "id": "col_1_menu",
      "label": "Column 1 menu"
    },
    {
      "type": "text",
      "id": "col_2_heading",
      "label": "Column 2 heading",
      "default": "HELP"
    },
    {
      "type": "link_list",
      "id": "col_2_menu",
      "label": "Column 2 menu"
    },
    {
      "type": "text",
      "id": "col_3_heading",
      "label": "Column 3 heading",
      "default": "FAQ"
    },
    {
      "type": "link_list",
      "id": "col_3_menu",
      "label": "Column 3 menu"
    },
    {
      "type": "text",
      "id": "col_4_heading",
      "label": "Column 4 heading",
      "default": "RESOURCES"
    },
    {
      "type": "link_list",
      "id": "col_4_menu",
      "label": "Column 4 menu"
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "Shop.co © 2000-2023, All Rights Reserved"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "Show payment badges",
      "default": true
    }
  ]
}
{% endschema %}
